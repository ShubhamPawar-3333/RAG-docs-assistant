# Google AI Studio (Gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Langfuse (Observability)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# Upstash Redis (Caching) - Optional
UPSTASH_REDIS_URL=your_upstash_redis_url_here
UPSTASH_REDIS_TOKEN=your_upstash_redis_token_here

# Application Settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# RAG Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# Ingestion limits
MAX_UPLOAD_FILES=20
MAX_FILE_SIZE_MB=10
MAX_TOTAL_UPLOAD_MB=50

# Model Settings
DEFAULT_MODEL=gemini-2.5-flash
FALLBACK_MODEL=groq/openai/gpt-oss-20b
TEMPERATURE=0.3
MAX_TOKENS=2048

# Per-provider chat model IDs (override when a vendor deprecates a model)
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GROQ_MODEL=openai/gpt-oss-20b
